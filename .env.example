# Database
DATABASE_URL=sqlite:///./hookbox.db
# DATABASE_URL=postgresql://user:pass@localhost/hookbox

# Security
# To generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b\"your_secure_key\", bcrypt.gensalt()).decode())"
ADMIN_API_KEY_HASH=$2b$12$example_bcrypt_hash_here_replace_this
SECRET_KEY=your-secret-key-change-in-production

# App settings
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_WEBHOOK_BODY_SIZE=1048576  # 1MiB

# Replay settings
DEFAULT_REPLAY_TIMEOUT=10
MAX_REPLAY_TIMEOUT=30
BLOCK_PRIVATE_IPS=true

